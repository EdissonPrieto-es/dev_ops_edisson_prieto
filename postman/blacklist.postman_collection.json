{
  "info": {
    "name": "Blacklist API - DevOps",
    "description": "Microservicio para que los sistemas internos consulten y agreguen emails a la lista negra global.\n\n**Autorización:** todos los endpoints de `/blacklists` usan un token estático: `Authorization: Bearer <API_TOKEN>`. Se configura en la variable `api_token` del environment.\n\n**Orden:** corre la colección completa en orden (Collection Runner). Los escenarios de consulta usan los emails que crean los escenarios de agregar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"App y BD ok\", () => pm.expect(pm.response.json()).to.eql({status: \"ok\", database: \"ok\"}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica que la app y la base de datos (RDS) estén disponibles. No requiere token.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/health",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "health"
                  ]
                },
                "auth": {
                  "type": "noauth"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n    \"status\": \"ok\",\n    \"database\": \"ok\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "POST /blacklists - Agregar email",
      "description": "Agrega un email a la lista negra global. Guarda también la IP de origen y la fecha/hora de la solicitud.",
      "item": [
        {
          "name": "Agregar email con motivo (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `user_${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Responde JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Confirma el email agregado\", () => {",
                  "    pm.expect(pm.response.json().message).to.include(pm.collectionVariables.get(\"email\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists"
              ]
            },
            "description": "Agrega un email nuevo a la lista negra global con `blocked_reason`. El email se genera en el pre-request para que la colección se pueda correr varias veces.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email}}\",\n    \"app_uuid\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"blocked_reason\": \"spam\"\n}",
